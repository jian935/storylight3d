<Slide style={{ width: '1280px', height: '720px', background: '#0F172A', padding: 60, display: 'flex', flexDirection: 'column' }}>
  <Box style={{ marginBottom: 24 }}>
    <Text style={{ fontSize: 16, color: '#22D3EE', letterSpacing: 2 }}>交互体验</Text>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#FFFFFF', marginTop: 8 }}>可旋转、可缩放、可漫游</Text>
    <Box style={{ width: '100%', height: 1, background: 'rgba(79,70,229,0.5)', marginTop: 16 }} />
  </Box>
  <Box style={{ flex: 1, display: 'flex', flexDirection: 'row', gap: 32, alignItems: 'center' }}>
    <Box style={{ width: 500 }}>
      <Image src="assets/focus.png" style={{ width: '100%', height: 312, objectFit: 'cover', borderRadius: 10 }} />
    </Box>
    <Box style={{ flex: 1, display: 'flex', flexDirection: 'column', gap: 18 }}>
      <Box style={{ paddingBottom: 16, borderBottom: '1px solid rgba(148,163,184,0.25)' }}>
        <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#F0ABFC' }}>OrbitControls 自由视角</Text>
        <Text style={{ fontSize: 17, color: '#E2E8F0', marginTop: 6, lineHeight: 1.5 }}>鼠标拖拽旋转、滚轮缩放，360° 观察每个实体。</Text>
      </Box>
      <Box style={{ paddingBottom: 16, borderBottom: '1px solid rgba(148,163,184,0.25)' }}>
        <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#F0ABFC' }}>故事切换器一键换景</Text>
        <Text style={{ fontSize: 17, color: '#E2E8F0', marginTop: 6, lineHeight: 1.5 }}>下拉切换精灵森林 / 轨道机甲 / 云雾茶舍。</Text>
      </Box>
      <Box>
        <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#F0ABFC' }}>自动进场，直接沉浸</Text>
        <Text style={{ fontSize: 17, color: '#E2E8F0', marginTop: 6, lineHeight: 1.5 }}>manifest 驱动按需加载，打开即进入 3D 场景。</Text>
      </Box>
    </Box>
  </Box>
  <Box style={{ marginTop: 18, padding: 14, background: 'rgba(34,211,238,0.12)', borderRadius: 8 }}>
    <Text style={{ fontSize: 17, color: '#E2E8F0' }}>读者不是在看截图，而是真正走进了故事。</Text>
  </Box>
  <Box style={{ display: 'flex', justifyContent: 'space-between', marginTop: 14, fontSize: 14, color: '#64748B' }}>
    <Text style={{ fontSize: 14, color: '#64748B' }}>StoryLight3D · Aholo 3D 黑客松</Text>
    <Text style={{ fontSize: 14, color: '#64748B' }}>08 / 12</Text>
  </Box>
</Slide>
